ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ANTHROPIC_API_KEY=
NEWSAPI_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
DATABASE_URL=
DASHBOARD_SECRET=
NOTIFY_EMAIL=
REACT_APP_API_URL=http://localhost:8000

# ── SABLE Discord Bot (full bot — responds in channels, posts trade updates) ───
# Get token from discord.com/developers → Your App → Bot → Token
DISCORD_BOT_TOKEN=
# Right-click a channel → Copy Channel ID (enable Developer Mode first)
DISCORD_FEED_CHANNEL_ID=
DISCORD_TALK_CHANNEL_ID=

# ── Mirror Agent (webhook-only — no bot token needed) ─────────────────────────
# In Discord: channel settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_MIRROR_WEBHOOK_URL=
# Fallback if DISCORD_MIRROR_WEBHOOK_URL not set
DISCORD_WEBHOOK_URL=

# ── Mirror Agent tuning ────────────────────────────────────────────────────────
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=Mirror-Agent
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_ENV=demo
SYMBOLS=MESM6,MNQM6
SCORE_THRESHOLD=75
SETUP_FORMING_MIN=55
ALERT_COOLDOWN_MINUTES=10
MIRROR_WAIT_SILENT=true
MIRROR_HEARTBEAT_MINUTES=30
MES_STOP_POINTS=5
MES_TARGET_POINTS=6
MNQ_STOP_POINTS=30
MNQ_TARGET_POINTS=40
PAPER_MAX_MINUTES=45
